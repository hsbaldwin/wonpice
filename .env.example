# Canonical URLs and same-origin API validation. Change before the production build.
# When using another local port, update this value and restart the server.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Preview default: robots disallow, noindex metadata, empty sitemap.
# Set true only for the intended public domain, then rebuild.
SITE_INDEXABLE=false

# Server-only SQLite database. Use an absolute path on a persistent disk in production.
DATABASE_PATH=data/analytics.sqlite

# Generate both with: npm run admin:setup
# Leaving either blank locks /admin and CSV export.
# A dotenv file must escape the scrypt hash dollar signs: scrypt\$salt\$key
# The setup command prints correctly escaped values for .env.local.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Enable only when a controlled reverse proxy overwrites X-Forwarded-For.
# false uses shared process-level request buckets; no client address is stored in SQLite.
TRUST_PROXY=false

# Local/self-hosted analytics. Vercel builds always disable SQLite analytics for now.
NEXT_PUBLIC_ANALYTICS_ENABLED=true
